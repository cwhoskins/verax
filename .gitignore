# Project-local agent debugging workspace: throwaway scripts/logs written by
# .pi/extensions/debug-tools (the debugger agent's only writable location).
/.tmp/

# Compiled binaries. Nim names an executable after its source file with no
# extension, so these are listed by path rather than by pattern -- there is
# nothing about `examples/divider` that says "binary" except that
# `examples/divider.nim` sits next to it.
/bin/
/out/
nimcache/
*.exe
*.dll
*.so
*.dylib

# Built examples, tests and designs: every .nim in these directories compiles
# to a same-named extensionless sibling.
/examples/*
!/examples/*.nim
/tests/*
!/tests/*.nim
!/tests/config.nims
# Nim reads `<file>.nim.cfg` as a per-file config, which is how a single test
# gets a compiler switch the rest of the suite must not have --
# `test_xspice_i2c_eeprom.nim` needs `-d:xspiceSpecOnly` because it imports
# XSPICE code models for their `ModelSpec` and would otherwise try to build
# their FFI against ngspice headers. It is source, not a build artefact.
!/tests/*.nim.cfg
# `tests/fixtures/` holds committed, non-`.nim` sample data (e.g. a trimmed
# real `.kicad_pcb` board for `test_pcb_sexp.nim`/`test_pcb_kicad.nim`'s
# byte-exactness proofs) -- `/tests/*` above would otherwise ignore it, since
# nothing in that block un-ignores a data file. `listFiles("tests")` in the
# `test` task is non-recursive, so nothing under this subdirectory is ever
# picked up and compiled as a test on its own.
!/tests/fixtures/
!/tests/fixtures/*
# Vendor `.ibs` files are licensed, never committed: drop them here for manual
# runs against the SI engine (docs/ibis_simulator_plan.md, stage 0).
/tests/fixtures/ibis/vendor/
/designs/*
!/designs/*.nim
!/designs/README
!/designs/CLAUDE.md
# `/designs/*` excludes the `lib` *directory*, and git does not descend into an
# excluded directory -- so `!/designs/*.nim` cannot rescue anything under it,
# and the whole shared parts/subcircuit library was untracked. Re-include the
# directory first, then apply the same source-only rule inside it.
!/designs/lib/
/designs/lib/*
!/designs/lib/*.nim
# `designs/datalogger/` is the first design nested in its own directory
# (its binary would otherwise collide with the directory name) -- same
# re-include-then-source-only-filter dance, one level deeper for its own
# `lib/` of board-specific sheets.
!/designs/datalogger/
/designs/datalogger/*
!/designs/datalogger/*.nim
!/designs/datalogger/lib/
/designs/datalogger/lib/*
!/designs/datalogger/lib/*.nim
# `designs/datalogger/ibis/` holds the USB host's synthetic stand-in model
# (written here from the USB 2.0 spec, not a vendor's file). The STM32's own
# vendor `.ibs` is licensed and stays out, under `designs/lib/stm32/`.
!/designs/datalogger/ibis/
/designs/datalogger/ibis/*
!/designs/datalogger/ibis/*.ibs
# `designs/si_spi/` holds the SI demo's synthetic IBIS models and its
# hand-written board -- data, not build output.
!/designs/si_spi/
/designs/si_spi/*
!/designs/si_spi/*.ibs
!/designs/si_spi/*.kicad_pcb
# `designs/rf_trx/` holds the gain block's synthetic Touchstone file (the
# `sparams` annotation points at it) -- data, not build output.
!/designs/rf_trx/
/designs/rf_trx/*
!/designs/rf_trx/*.s2p
/templates/*
!/templates/*.nim

# nimble
nimble.develop
nimble.paths
/nimbledeps/

# python/: the nimpy extension (`*.so` above already covers verax_py.so)
# plus ordinary Python build byproducts.
python/**/__pycache__/
python/nimcache/
