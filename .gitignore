# Project-local agent debugging workspace: throwaway scripts/logs written by
# .pi/extensions/debug-tools (the debugger agent's only writable location).
/.tmp/

# Compiled binaries. Nim names an executable after its source file with no
# extension, so these are listed by path rather than by pattern -- there is
# nothing about `examples/divider` that says "binary" except that
# `examples/divider.nim` sits next to it.
/bin/
/out/
/mcp/nimcir_mcp
nimcache/
*.exe
*.dll
*.so
*.dylib

# Built examples, tests and designs: every .nim in these directories compiles
# to a same-named extensionless sibling.
/examples/*
!/examples/*.nim
/tests/*
!/tests/*.nim
!/tests/config.nims
# Nim reads `<file>.nim.cfg` as a per-file config, which is how a single test
# gets a compiler switch the rest of the suite must not have --
# `test_xspice_i2c_eeprom.nim` needs `-d:xspiceSpecOnly` because it imports
# XSPICE code models for their `ModelSpec` and would otherwise try to build
# their FFI against ngspice headers. It is source, not a build artefact.
!/tests/*.nim.cfg
/designs/*
!/designs/*.nim
!/designs/README
!/designs/CLAUDE.md
# `/designs/*` excludes the `lib` *directory*, and git does not descend into an
# excluded directory -- so `!/designs/*.nim` cannot rescue anything under it,
# and the whole shared parts/subcircuit library was untracked. Re-include the
# directory first, then apply the same source-only rule inside it.
!/designs/lib/
/designs/lib/*
!/designs/lib/*.nim
/templates/*
!/templates/*.nim

# nimble
nimble.develop
nimble.paths
/nimbledeps/
